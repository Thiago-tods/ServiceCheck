NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/servicecheck?schema=public
# Signs access tokens. Replace the placeholder below with a random secret from this command:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The strong-secret policy applies to every environment except an explicit NODE_ENV=development:
# production, test and a missing or empty NODE_ENV all refuse to start with a weak secret. It needs
# hex with 64+ characters or base64/base64url with 43+ (256 bits or more); placeholders, common
# words, repeats and sequences are rejected. Set NODE_ENV=production on servers. Only
# NODE_ENV=development tolerates the placeholder, with a warning.
JWT_ACCESS_SECRET=REPLACE_ME__generate_a_secret_with_the_command_above
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# File storage: local (development) or s3 (any S3-compatible service)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_BUCKET=servicecheck
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

RATE_LIMIT_ENABLED=true
JOBS_WORKER_ENABLED=true
# Optional error monitoring; leave empty to disable
SENTRY_DSN=