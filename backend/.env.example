NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/servicecheck?schema=public
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# File storage: local (development) or s3 (any S3-compatible service)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_BUCKET=servicecheck
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

RATE_LIMIT_ENABLED=true
JOBS_WORKER_ENABLED=true
# Optional error monitoring; leave empty to disable
SENTRY_DSN=