generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  RECEPTIONIST
  PROFESSIONAL
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  locale       String   @default("pt_BR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  clients     Client[]
  specialties Specialty[]
  teams       Team[]
  services    Service[]
}

/// A user may belong to several companies; role and permissions are per company.
model Membership {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  companyId           String   @db.Uuid
  role                Role
  /// Explicit permission to review missing/refused signatures without being Owner/Admin.
  canReviewSignatures Boolean  @default(false)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  specialties MembershipSpecialty[]
  teams       TeamMember[]

  @@unique([userId, companyId])
  @@index([companyId])
}

/// Rotating refresh tokens. Only the SHA-256 hash is stored.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
}

/// Append-only audit trail. Never updated or deleted by application code.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
}

enum ChecklistItemKind {
  CHECK
  TEXT
  NUMBER
  PHOTO
}

model Client {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  name      String
  document  String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company         @relation(fields: [companyId], references: [id])
  contacts  ClientContact[]
  addresses ClientAddress[]

  @@index([companyId, name])
}

model ClientContact {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  clientId  String  @db.Uuid
  name      String
  role      String?
  phone     String?
  email     String?
  active    Boolean @default(true)

  client Client @relation(fields: [clientId], references: [id])

  @@index([companyId, clientId])
}

model ClientAddress {
  id         String  @id @default(uuid()) @db.Uuid
  companyId  String  @db.Uuid
  clientId   String  @db.Uuid
  label      String
  street     String
  number     String?
  complement String?
  district   String?
  city       String
  state      String
  zip        String?
  latitude   Float?
  longitude  Float?
  active     Boolean @default(true)

  client Client @relation(fields: [clientId], references: [id])

  @@index([companyId, clientId])
}

model Specialty {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  name      String
  active    Boolean @default(true)

  company Company               @relation(fields: [companyId], references: [id])
  members MembershipSpecialty[]

  @@unique([companyId, name])
}

model MembershipSpecialty {
  membershipId String @db.Uuid
  specialtyId  String @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id])
  specialty  Specialty  @relation(fields: [specialtyId], references: [id])

  @@id([membershipId, specialtyId])
}

model Team {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  name      String
  active    Boolean @default(true)

  company Company      @relation(fields: [companyId], references: [id])
  members TeamMember[]

  @@unique([companyId, name])
}

model TeamMember {
  teamId       String @db.Uuid
  membershipId String @db.Uuid

  team       Team       @relation(fields: [teamId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id])

  @@id([teamId, membershipId])
}

model Service {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  company  Company                   @relation(fields: [companyId], references: [id])
  versions ServiceChecklistVersion[]

  @@unique([companyId, name])
}

/// Immutable once created (enforced by trigger). Editing a checklist means publishing a new version.
model ServiceChecklistVersion {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  serviceId String   @db.Uuid
  version   Int
  createdBy String?  @db.Uuid
  createdAt DateTime @default(now())

  service Service         @relation(fields: [serviceId], references: [id])
  items   ChecklistItem[]

  @@unique([serviceId, version])
}

model ChecklistItem {
  id        String            @id @default(uuid()) @db.Uuid
  versionId String            @db.Uuid
  position  Int
  label     String
  kind      ChecklistItemKind @default(CHECK)
  required  Boolean           @default(false)

  checklistVersion ServiceChecklistVersion @relation(fields: [versionId], references: [id])

  @@unique([versionId, position])
}
